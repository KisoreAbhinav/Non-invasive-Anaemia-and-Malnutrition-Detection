APP_RUNTIME_MODE=raspi-local
BACKEND_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

STT_MODE=backend
# mock = JSON/text passthrough; vosk = 16kHz mono 16-bit PCM WAV inference.
# For vosk, extract an Indian-English model folder under models/vosk/.
STT_PROVIDER=mock
TTS_MODE=backend
# mock = return prompt text; piper = synthesize WAV with the bundled voice.
TTS_PROVIDER=mock
# Values above 1.0 slow Piper speech for accessibility.
TTS_LENGTH_SCALE=1.2

QUESTIONNAIRE_PATH=config/questionnaire.default.json
PREDICTION_MODELS_PATH=config/prediction-models.default.json
VISUAL_CUES_PATH=config/visual-cues.default.json
CLINICAL_FIELDS_PATH=config/clinical-fields.default.json
PREDICTION_DEFAULT_MODEL=baseline-rule-v1
